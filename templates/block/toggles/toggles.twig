<section class="b-toggles">
	<div class="container">
		<x-toggles>
			{% for item in props.items %}
				<div class="b-toggles__item">
					<button class="b-toggles__item-cta js-cta" data-index="{{ loop.index0 }}">{{ item.title }}</button>
					<div class="wysiwyg b-toggles__item-content js-content">
						{{ item.description|raw }}
					</div>
				</div>
			{% endfor %}
		</x-toggles>
	</div>
</section>